# Secrets Map — 1Password → Target Mapping
# Format: CATEGORY|1PASSWORD_ITEM|1PASSWORD_FIELD|TARGET_TYPE|TARGET_LOCATION|SECRET_NAME
#
# TARGET_TYPE:
#   gh  = GitHub Secret (TARGET_LOCATION = repo name under studio-b-ai/)
#   rw  = Railway env var (TARGET_LOCATION = project/service)
#
# CATEGORY is used by rotate-secrets.sh to filter which secrets to push.
# Lines starting with # are comments. Blank lines are ignored.

# ─── Acumatica API Credentials ───────────────────────────────────────────────
# api-bot (prod)
acumatica|acumatica-api-bot|username|gh|acumatica-ci-cd|ACUMATICA_PROD_USERNAME
acumatica|acumatica-api-bot|password|gh|acumatica-ci-cd|ACUMATICA_PROD_PASSWORD
acumatica|acumatica-api-bot|password|gh|webhook-router|ACUMATICA_PASSWORD
acumatica|acumatica-api-bot|password|rw|studiob-platform/acudev|ACUMATICA_BROWSER_PASSWORD
acumatica|acumatica-api-bot|username|rw|studiob-platform/acudev|ACUMATICA_BROWSER_USERNAME
acumatica|acumatica-api-bot|password|rw|studiob-platform/webhook-router|ACUMATICA_PASSWORD
acumatica|acumatica-api-bot|password|rw|studiob-platform/studiob-api|ACUMATICA_PASSWORD
acumatica|acumatica-api-bot|username|rw|studiob-platform/studiob-api|ACUMATICA_USERNAME
acumatica|acumatica-api-bot|password|rw|aesthetik-production/heritage-wms|ACUMATICA_PASSWORD
acumatica|acumatica-api-bot|username|rw|aesthetik-production/heritage-wms|ACUMATICA_USERNAME

# api-dashboard
acumatica|acumatica-api-dashboard|password|rw|studiob-platform/webhook-router|ACUMATICA_PASSWORD

# api-test (staging)
acumatica|acumatica-api-test|password|gh|acumatica-ci-cd|ACUMATICA_STG_PASSWORD

# sandbox (heritagefabrics-sandbox.acumatica.com — separate SaaS instance)
# All four secrets sourced from acumatica-api-test (NOT acumatica-api-bot,
# which is the prod-instance bot — see 2026-04-07 prod-restart incident).
# host and tenant are custom fields on the 1P item; they MUST be rotated
# along with the credentials so the sandbox host/tenant cannot be silently
# repointed at prod.
acumatica|acumatica-api-test|host|gh|acumatica-ci-cd|ACUMATICA_SANDBOX_URL
acumatica|acumatica-api-test|tenant|gh|acumatica-ci-cd|ACUMATICA_SANDBOX_TENANT
acumatica|acumatica-api-test|username|gh|acumatica-ci-cd|ACUMATICA_SANDBOX_USERNAME
acumatica|acumatica-api-test|password|gh|acumatica-ci-cd|ACUMATICA_SANDBOX_PASSWORD
acumatica|acumatica-api-test|password|rw|studiob-platform/acudev|ACUMATICA_SANDBOX_PASSWORD
acumatica|acumatica-api-test|username|rw|studiob-platform/acudev|ACUMATICA_SANDBOX_USERNAME

# ─── Gateway Tokens ──────────────────────────────────────────────────────────
gateway|gateway-token-studiob|credential|rw|studiob-platform/studiob-api|ACUMATICA_GATEWAY_TOKEN
gateway|gateway-token-studiob|credential|rw|studiob-platform/acudev|ACUMATICA_GATEWAY_TOKEN
gateway|gateway-token-studiob|credential|rw|studiob-platform/webhook-router|ACUMATICA_GATEWAY_TOKEN
gateway|gateway-token-aesthetik|credential|rw|aesthetik-production/heritage-wms|ACUMATICA_GATEWAY_TOKEN

# ─── Anthropic API Keys (org, per-project) ───────────────────────────────────
anthropic|anthropic-org-acuops-cicd|credential|gh|acumatica-ci-cd|ANTHROPIC_API_KEY
anthropic|anthropic-org-acudev|credential|rw|studiob-platform/acudev|ANTHROPIC_API_KEY
anthropic|anthropic-org-webhook-router|credential|rw|studiob-platform/webhook-router|ANTHROPIC_API_KEY
anthropic|anthropic-org-heritage-wms|credential|rw|aesthetik-production/heritage-wms|ANTHROPIC_API_KEY
anthropic|anthropic-org-studiob-agents|credential|rw|studiob-platform/studiob-agents|ANTHROPIC_API_KEY
anthropic|anthropic-org-cs-order-entry|credential|rw|aesthetik-production/cs-order-entry|ANTHROPIC_API_KEY

