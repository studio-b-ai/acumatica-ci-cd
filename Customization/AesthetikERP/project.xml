  <Sql Name="AesthetikWMS_Columns_v1" Script="#CDATA">
    <CDATA name="Script"><![CDATA[
-- INLotSerialClass extension fields (4 columns)
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialClass') AND name = 'UsrMinRemnant')
  ALTER TABLE INLotSerialClass ADD UsrMinRemnant decimal(18,2) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialClass') AND name = 'UsrAutoPrint')
  ALTER TABLE INLotSerialClass ADD UsrAutoPrint bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialClass') AND name = 'UsrDefaultWidth')
  ALTER TABLE INLotSerialClass ADD UsrDefaultWidth decimal(18,1) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialClass') AND name = 'UsrPreRecvEnabled')
  ALTER TABLE INLotSerialClass ADD UsrPreRecvEnabled bit NULL;
-- INLotSerialStatus extension fields (9 columns)
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrActualYardage')
  ALTER TABLE INLotSerialStatus ADD UsrActualYardage decimal(18,2) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrDyeLot')
  ALTER TABLE INLotSerialStatus ADD UsrDyeLot nvarchar(30) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrWidth')
  ALTER TABLE INLotSerialStatus ADD UsrWidth decimal(18,1) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrShadeCode')
  ALTER TABLE INLotSerialStatus ADD UsrShadeCode nvarchar(10) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrSourceRoll')
  ALTER TABLE INLotSerialStatus ADD UsrSourceRoll nvarchar(30) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrDefectFlag')
  ALTER TABLE INLotSerialStatus ADD UsrDefectFlag bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrInventoryStatus')
  ALTER TABLE INLotSerialStatus ADD UsrInventoryStatus nvarchar(15) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrPreAssignedBin')
  ALTER TABLE INLotSerialStatus ADD UsrPreAssignedBin nvarchar(30) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INLotSerialStatus') AND name = 'UsrContainerNo')
  ALTER TABLE INLotSerialStatus ADD UsrContainerNo nvarchar(30) NULL;
-- INSetup extension fields — Piece Goods preferences (14 columns)
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGMinRemnant')
  ALTER TABLE INSetup ADD UsrPGMinRemnant decimal(18,2) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGAutoQtyMode')
  ALTER TABLE INSetup ADD UsrPGAutoQtyMode bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGAutoPrint')
  ALTER TABLE INSetup ADD UsrPGAutoPrint bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGCutSuffix')
  ALTER TABLE INSetup ADD UsrPGCutSuffix nvarchar(20) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGPreRecv')
  ALTER TABLE INSetup ADD UsrPGPreRecv bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGCrossDock')
  ALTER TABLE INSetup ADD UsrPGCrossDock bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGXDockAge')
  ALTER TABLE INSetup ADD UsrPGXDockAge int NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGInTransitWt')
  ALTER TABLE INSetup ADD UsrPGInTransitWt int NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGYardageVar')
  ALTER TABLE INSetup ADD UsrPGYardageVar decimal(18,4) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGWtExact')
  ALTER TABLE INSetup ADD UsrPGWtExact int NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGWtRemnant')
  ALTER TABLE INSetup ADD UsrPGWtRemnant int NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGWtDyeLot')
  ALTER TABLE INSetup ADD UsrPGWtDyeLot int NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGWtLocation')
  ALTER TABLE INSetup ADD UsrPGWtLocation int NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INSetup') AND name = 'UsrPGWtFIFO')
  ALTER TABLE INSetup ADD UsrPGWtFIFO int NULL;
-- POOrder extension fields (3 columns) — from HeritageFabricsPOv5
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('POOrder') AND name = 'UsrExpArrivalDate')
  ALTER TABLE POOrder ADD UsrExpArrivalDate datetime NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('POOrder') AND name = 'UsrActArrivalDate')
  ALTER TABLE POOrder ADD UsrActArrivalDate datetime NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('POOrder') AND name = 'UsrContainerRef')
  ALTER TABLE POOrder ADD UsrContainerRef nvarchar(50) NULL;
-- POLine extension fields (2 columns) — from HeritageFabricsPOv5
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('POLine') AND name = 'UsrExpArrivalDate')
  ALTER TABLE POLine ADD UsrExpArrivalDate datetime NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('POLine') AND name = 'UsrActArrivalDate')
  ALTER TABLE POLine ADD UsrActArrivalDate datetime NULL;
-- SOOrder extension fields (4 columns) — from HeritageFabricsPOv5
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrHubSpotDealId')
  ALTER TABLE SOOrder ADD UsrHubSpotDealId nvarchar(50) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrWMSStatus')
  ALTER TABLE SOOrder ADD UsrWMSStatus nvarchar(20) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrComplianceHold')
  ALTER TABLE SOOrder ADD UsrComplianceHold bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrComplianceHoldReason')
  ALTER TABLE SOOrder ADD UsrComplianceHoldReason nvarchar(500) NULL;
-- BAccount extension field (1 column) — from HeritageFabricsPOv5
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('BAccount') AND name = 'UsrDisablePayLink')
  ALTER TABLE BAccount ADD UsrDisablePayLink bit NULL;
]]></CDATA>
