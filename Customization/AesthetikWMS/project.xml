<Customization level="3" description="AesthetikWMS — Consolidated WMS, ERP extensions, PO Relations/Activities" product-version="24.208">
    <Sql Name="AesthetikWMS_SOOrder_BAccount_Columns_v1" Script="#CDATA">
        <CDATA name="Script"><![CDATA[
-- SOOrder compliance hold fields (from AesthetikERP consolidation)
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrComplianceHold')
  ALTER TABLE SOOrder ADD UsrComplianceHold bit NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrComplianceHoldReason')
  ALTER TABLE SOOrder ADD UsrComplianceHoldReason nvarchar(500) NULL;
-- SOOrder HubSpot + WMS fields
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrHubSpotDealId')
  ALTER TABLE SOOrder ADD UsrHubSpotDealId nvarchar(50) NULL;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOOrder') AND name = 'UsrWMSStatus')
  ALTER TABLE SOOrder ADD UsrWMSStatus nvarchar(20) NULL;
-- BAccount pay link disable field
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('BAccount') AND name = 'UsrDisablePayLink')
  ALTER TABLE BAccount ADD UsrDisablePayLink bit NULL;
-- SOShipment container fields (AesthetikContainers ShipmentExt)
-- Belt-and-suspenders: also created by AesthetikContainers CustomizationPlugin,
-- but plugin may not run if connection string is unavailable on Cloud.
-- SEV-1 fix: SHIP006390 CommandPreparing error — columns missing from DB.
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOShipment') AND name = 'UsrIncludeInContainer')
  ALTER TABLE SOShipment ADD UsrIncludeInContainer bit NULL DEFAULT 0;
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('SOShipment') AND name = 'UsrContainerID')
  ALTER TABLE SOShipment ADD UsrContainerID int NULL;
]]></CDATA>
    </Sql>
    <Sql Name="AesthetikWMS_INItemXRef_ExpiryDate_v1" Script="#CDATA">
        <CDATA name="Script"><![CDATA[
-- INItemXRef expiry date field (absorbed from WMSynergy ExpirationDateAtStockItems)
IF NOT EXISTS (SELECT 1 FROM sys.columns WHERE object_id = OBJECT_ID('INItemXRef') AND name = 'UsrHFExpiryDate')
  ALTER TABLE INItemXRef ADD UsrHFExpiryDate date NULL;
]]></CDATA>
    </Sql>
