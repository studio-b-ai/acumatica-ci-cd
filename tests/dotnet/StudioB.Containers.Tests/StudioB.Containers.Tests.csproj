<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>StudioB.Containers.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <!--
    Link pure-logic source files from StudioB.Containers so we can test them
    without pulling in any Acumatica assemblies (which are net48-only).
  -->
  <ItemGroup>
    <Compile Include="..\..\..\src\StudioB.Containers\Graphs\ContainerRiskCalculator.cs">
      <Link>Linked\ContainerRiskCalculator.cs</Link>
    </Compile>
  </ItemGroup>
</Project>
