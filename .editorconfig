# .editorconfig for acumatica-ci-cd
#
# Scoped to C# source under src/ (Acumatica customization projects).
# Primary purpose: control Acuminator Roslyn analyzer severity so
# pre-existing code-style findings don't block CI/CD deploys.

root = true

[*.cs]
# ─────────────────────────────────────────────────────────────────
# Acuminator PX-series diagnostics — baseline suppression to warning
# ─────────────────────────────────────────────────────────────────
# Acuminator reports many diagnostics at severity=error by default.
# dotnet build treats these as compile errors and skips DLL output,
# which blocks the build-validate gate and therefore every deploy.
#
# Context: before 2026-04-07, Acuminator never ran in CI (Linux build
# job skips Windows-only analyzers). The codebase accumulated findings
# that nobody saw until the self-hosted Windows runner came online
# (PR #257 / PR #264). See acumatica-ci-cd#267 for the tracking issue
# that enumerates known findings.
#
# Strategy: treat the entire PX-series as warnings for now. This lets
# deploys proceed, surfaces the findings in build logs as advisory,
# and gives us room to fix them incrementally. As we clean up a rule,
# we can override its severity back to error individually below so
# regressions fail the build.
#
# NOTE: this is a blanket demotion, not a blanket ignore. Every PX
# finding still appears in the build-validate log and step summary.
#
# Baseline: 2026-04-07
# Owner: acumatica-ci-cd#267
# Target: restore severity=error per-rule as fixes land

# Wildcard fallback — applies to every Acuminator rule not overridden
# below. Rule IDs follow the pattern PX<4 digits>.
dotnet_diagnostic.PX1000.severity = warning
dotnet_diagnostic.PX1001.severity = warning
dotnet_diagnostic.PX1002.severity = warning
dotnet_diagnostic.PX1003.severity = warning
dotnet_diagnostic.PX1004.severity = warning
dotnet_diagnostic.PX1005.severity = warning
dotnet_diagnostic.PX1006.severity = warning
